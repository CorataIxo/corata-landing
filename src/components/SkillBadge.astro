---
interface Props {
  name: string;
  level: string;
  percentage: number;
}
const { name, level, percentage } = Astro.props;

let dotColor = '#008471';
if (percentage >= 80)      dotColor = '#008471';
else if (percentage >= 60) dotColor = '#006B5C';
else                       dotColor = '#C56D66';

let fillColor = dotColor;
---

<div style="display:flex;align-items:center;gap:12px;padding:13px 22px;border-bottom:1px solid #EBEBEA;transition:background 0.12s;cursor:default;"
     onmouseover="this.style.background='#F8F8F6'" onmouseout="this.style.background='transparent'">

  <div style={`width:7px;height:7px;border-radius:50%;background:${dotColor};flex-shrink:0`}></div>

  <div style="flex:1;min-width:0">
    <p style="font-family:'Inter',sans-serif;font-size:13px;font-weight:600;color:#0F0F0E;line-height:1.2">{name}</p>
    <p style="font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.08em;text-transform:uppercase;color:#9A9A92;margin-top:2px">{level}</p>
  </div>

  <div style="text-align:right;flex-shrink:0">
    <p style="font-family:'Inter',sans-serif;font-size:14px;font-weight:800;color:#0F0F0E;letter-spacing:-0.02em">{percentage}%</p>
    <div style="width:44px;height:2px;background:#EBEBEA;border-radius:2px;margin-top:5px;overflow:hidden">
      <div style={`height:100%;width:${percentage}%;background:${fillColor};border-radius:2px;animation:growBar 1.4s cubic-bezier(.16,1,.3,1) forwards`}></div>
    </div>
  </div>

</div>

<style>
  @keyframes growBar { from { width: 0 !important; } }
</style>
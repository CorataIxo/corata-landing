---
interface Props {
  name: string;
  level: string;
  percentage: number;
  type?: 'verified' | 'developing';
}
const { name, level, percentage } = Astro.props;

// Single analytical color — eggplant. Clean, consistent, serious.
const color   = '#6B2D5E';
const barBase = '#EBEBEA';
---

<div
  style="display:flex;align-items:center;gap:13px;padding:14px 22px;border-bottom:1px solid #EBEBEA;transition:background 0.16s;cursor:default;"
  onmouseover="this.style.background='rgba(107,45,94,0.04)'"
  onmouseout="this.style.background='transparent'"
>
  <div style={`width:5px;height:5px;border-radius:50%;background:${color};flex-shrink:0;opacity:0.7`}></div>

  <div style="flex:1;min-width:0">
    <p style="font-family:'Inter',sans-serif;font-size:13px;font-weight:600;color:#0D0D0B;line-height:1.2;margin:0">{name}</p>
    <p style="font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.09em;text-transform:uppercase;color:#9A9A92;margin:2px 0 0">{level}</p>
  </div>

  <div style="text-align:right;flex-shrink:0">
    <p style={`font-family:'Inter',sans-serif;font-size:14px;font-weight:800;letter-spacing:-0.02em;color:${color};margin:0`}>{percentage}%</p>
    <div style={`width:44px;height:2px;background:${barBase};border-radius:2px;margin-top:6px;overflow:hidden`}>
      <div style={`height:100%;width:${percentage}%;background:${color};border-radius:2px;animation:growBar 1.4s cubic-bezier(.16,1,.3,1) forwards`}></div>
    </div>
  </div>
</div>

<style>
  @keyframes growBar { from { width: 0 !important; } }
</style>
---
---

<div class="ch-card" id="challenge-card">

  <div class="ch-head">
    <div>
      <span class="ch-label">Reto activo</span>
      <div class="ch-sublabel" id="ch-mechanic-label">Priorización bajo presión</div>
    </div>
    <div class="ch-dots">
      <span class="ch-dot active" id="dot-0"></span>
      <span class="ch-dot" id="dot-1"></span>
      <span class="ch-dot" id="dot-2"></span>
    </div>
  </div>

  <!-- Reto 0: Prioridad dinámica -->
  <div class="ch-body active" id="ch-0">
    <div class="ch-situation">
      <p>Tienes cuatro tareas abiertas. <strong>A mitad del tiempo, un cliente reporta un fallo crítico en producción.</strong></p>
    </div>
    <div class="ch-event">
      <span class="ch-event-dot"></span>
      <span>Evento inesperado detectado — 14:32</span>
    </div>
    <div class="ch-options">
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN A</span>
        <span class="ch-opt-text">Pausar tareas actuales y atender el fallo de forma inmediata</span>
      </div>
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN B</span>
        <span class="ch-opt-text">Finalizar la tarea crítica en curso antes de redirigir</span>
      </div>
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN C</span>
        <span class="ch-opt-text">Escalar el fallo al equipo técnico y mantener el plan</span>
      </div>
    </div>
    <div class="ch-measure">El sistema mide tu velocidad de adaptación y criterio de priorización.</div>
  </div>

  <!-- Reto 1: Flujo con error -->
  <div class="ch-body" id="ch-1">
    <div class="ch-situation">
      <p>El siguiente flujo de trabajo tiene <strong>un error estructural que genera fallos en producción.</strong> Identifica el paso incorrecto.</p>
    </div>
    <div class="ch-flow">
      <div class="ch-flow-step"><span class="ch-step-n">1</span><span>Recibir solicitud del cliente</span></div>
      <div class="ch-flow-step"><span class="ch-step-n">2</span><span>Aprobar solicitud internamente</span></div>
      <div class="ch-flow-step error"><span class="ch-step-n">3</span><span>Ejecutar tarea sin validar datos</span></div>
      <div class="ch-flow-step"><span class="ch-step-n">4</span><span>Validar datos y calidad</span></div>
      <div class="ch-flow-step"><span class="ch-step-n">5</span><span>Entregar resultado al cliente</span></div>
    </div>
    <div class="ch-measure">El sistema mide tu razonamiento estructural y detección de causa raíz.</div>
  </div>

  <!-- Reto 2: Instrucción ambigua -->
  <div class="ch-body" id="ch-2">
    <div class="ch-situation">
      <p>Un cliente solicita un informe urgente. <strong>No especifica formato, datos ni alcance.</strong> No responde mensajes. Tienes 4 horas.</p>
    </div>
    <div class="ch-options">
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN A</span>
        <span class="ch-opt-text">Esperar instrucciones claras antes de avanzar</span>
      </div>
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN B</span>
        <span class="ch-opt-text">Enviar formato estándar documentando los supuestos asumidos</span>
      </div>
      <div class="ch-option">
        <span class="ch-opt-tag">OPCIÓN C</span>
        <span class="ch-opt-text">Escalar la ambigüedad al responsable antes de actuar</span>
      </div>
    </div>
    <div class="ch-measure">El sistema mide tu autonomía, criterio y toma de decisiones bajo incertidumbre.</div>
  </div>

</div>

<style>
  .ch-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    box-shadow:
      0 1px 2px rgba(0,0,0,0.03),
      0 4px 12px rgba(0,0,0,0.05),
      0 16px 40px rgba(0,0,0,0.06);
    position: relative;
    font-family: 'Inter', sans-serif;
  }
  .ch-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: #6B2D5E;
    border-radius: 20px 20px 0 0;
    z-index: 2;
  }

  .ch-head {
    padding: 16px 20px 14px;
    border-bottom: 1px solid #EBEBEA;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .ch-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #9A9A92;
    display: block;
    margin-bottom: 3px;
  }
  .ch-sublabel {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B2D5E;
    opacity: 0.85;
  }
  .ch-dots { display: flex; gap: 5px; align-items: center; margin-top: 4px; }
  .ch-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #EBEBEA;
    transition: background 0.4s;
    flex-shrink: 0;
  }
  .ch-dot.active { background: #6B2D5E; }

  /* Body panels */
  .ch-body { display: none; padding: 18px 20px 20px; }
  .ch-body.active {
    display: block;
    animation: chIn 0.45s ease forwards;
  }
  @keyframes chIn {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Situation text */
  .ch-situation {
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.65;
    color: #555550;
    margin-bottom: 14px;
  }
  .ch-situation strong { font-weight: 600; color: #0D0D0B; }

  /* Event indicator */
  .ch-event {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #B08A00;
    background: rgba(255,208,0,0.07);
    border: 1px solid rgba(255,208,0,0.25);
    border-radius: 6px;
    padding: 7px 11px;
    margin-bottom: 14px;
  }
  .ch-event-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #FFD000;
    flex-shrink: 0;
    animation: blink 1.8s ease infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* Decision blocks */
  .ch-options { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; }
  .ch-option {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #F7F5F1;
    border: 1px solid #EBEBEA;
    border-radius: 9px;
    padding: 11px 14px;
    cursor: default;
    transition: border-color 0.15s, background 0.15s;
  }
  .ch-option:hover {
    border-color: rgba(107,45,94,0.25);
    background: rgba(107,45,94,0.03);
  }
  .ch-opt-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B2D5E;
    opacity: 0.8;
  }
  .ch-opt-text {
    font-size: 12px;
    font-weight: 500;
    color: #0D0D0B;
    line-height: 1.45;
  }

  /* Flow steps */
  .ch-flow { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
  .ch-flow-step {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 12px;
    font-weight: 500;
    color: #555550;
    padding: 9px 14px;
    border-radius: 9px;
    background: #F7F5F1;
    border: 1px solid #EBEBEA;
    line-height: 1.3;
  }
  .ch-flow-step.error {
    background: rgba(107,45,94,0.06);
    border-color: rgba(107,45,94,0.22);
    color: #6B2D5E;
    font-weight: 600;
  }
  .ch-step-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    font-weight: 600;
    color: #CECECE;
    min-width: 12px;
    flex-shrink: 0;
  }
  .ch-flow-step.error .ch-step-n { color: #6B2D5E; opacity: 0.6; }

  /* Bottom measurement label */
  .ch-measure {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #9A9A92;
    border-top: 1px solid #EBEBEA;
    padding-top: 12px;
    line-height: 1.55;
  }
</style>

<script>
  const bodies = [0,1,2].map(i => document.getElementById('ch-' + i));
  const dots   = [0,1,2].map(i => document.getElementById('dot-' + i));
  const labels = ['Priorización bajo presión', 'Razonamiento estructural', 'Autonomía e interpretación'];
  const mechEl = document.getElementById('ch-mechanic-label');
  let current  = 0;

  function show(idx) {
    bodies.forEach((b,i) => b.classList.toggle('active', i === idx));
    dots.forEach((d,i)   => d.classList.toggle('active', i === idx));
    if (mechEl) mechEl.textContent = labels[idx];
    current = idx;
  }

  setInterval(() => show((current + 1) % 3), 5500);
</script>
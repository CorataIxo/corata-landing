<section class="cta-band">
  <div class="cta-inner">
    <div>
      <h2 class="cta-h">El talento<br/>no se<br/><em>declara</em></h2>
      <p class="cta-p">Tu forma de pensar es tu mejor credencial. Corata la convierte en tu perfil profesional.</p>
    </div>
    <div class="cta-right">
      <div class="trust-item">
        <span class="t-label">Sin CV ni LinkedIn</span>
        <div class="t-check"><svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg></div>
      </div>
      <div class="trust-item">
        <span class="t-label">Basado en comportamiento, no declaraciones</span>
        <div class="t-check"><svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg></div>
      </div>
      <div class="trust-item">
        <span class="t-label">Siempre gratuito para candidatos</span>
        <div class="t-check"><svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg></div>
      </div>
      <div class="trust-item">
        <span class="t-label">Tú controlas quién ve tu perfil</span>
        <div class="t-check"><svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg></div>
      </div>
      <a href="/demo" class="btn-cta">
        Solicita tu demo gratis
        <span class="arr">↗</span>
      </a>
    </div>
  </div>
</section>

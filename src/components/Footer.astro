---
---

<footer class="footer">
  <!-- Grain overlay -->
  <div class="footer-grain" aria-hidden="true"></div>

  <div class="footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <span class="footer-logo">Corata</span>
      <span class="footer-copy">© 2026 Corata. All rights reserved.</span>
    </div>

    <!-- Social -->
    <div class="footer-social" role="list" aria-label="Redes sociales">

      <!-- Instagram -->
      <a href="#" class="social-link" aria-label="Instagram" role="listitem">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"/>
        </svg>
      </a>

      <!-- TikTok -->
      <a href="#" class="social-link" aria-label="TikTok" role="listitem">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
        </svg>
      </a>

    </div>

  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: #F9F8F6;
    border-top: 1px solid #EAEAE6;
    overflow: hidden;
  }

  /* Grain */
  .footer-grain {
    position: absolute;
    inset: 0;
    opacity: 0.045;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    background-repeat: repeat;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 48px 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px 28px 44px;
      gap: 24px;
    }
  }

  /* Brand block */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-logo {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0D0D0B;
    line-height: 1;
  }

  .footer-copy {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
    color: #AEAEA8;
    line-height: 1;
  }

  /* Social */
  .footer-social {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    color: #AEAEA8;
    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    color: #1F7A6C;
    border-color: rgba(31, 122, 108, 0.18);
    background: rgba(31, 122, 108, 0.05);
  }

  .social-link svg {
    display: block;
    flex-shrink: 0;
  }
</style>
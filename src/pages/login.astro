---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Acceder — Corata">

  <div class="reg-page">

    <a href="/" class="reg-back">← Corata</a>

    <div class="reg-card">

      <div class="reg-head">
        <span class="reg-eyebrow">Bienvenida de nuevo</span>
        <h1 class="reg-title">Accede a tu perfil</h1>
        <p class="reg-sub">Continúa donde lo dejaste.</p>
      </div>

      <form class="reg-form" action="#" method="post">

        <div class="reg-field">
          <label class="reg-label" for="email">Correo electrónico</label>
          <input class="reg-input" type="email" id="email" name="email" placeholder="tu@email.com" autocomplete="email" required />
        </div>

        <div class="reg-field">
          <div class="reg-label-row">
            <label class="reg-label" for="password">Contraseña</label>
            <a href="/recuperar" class="reg-forgot">¿La olvidaste?</a>
          </div>
          <input class="reg-input" type="password" id="password" name="password" placeholder="Tu contraseña" autocomplete="current-password" required />
        </div>

        <button type="submit" class="reg-submit">
          Acceder
          <span>→</span>
        </button>

      </form>

      <p class="reg-login">
        ¿Aún no tienes cuenta? <a href="/registro">Créala gratis</a>
      </p>

    </div>

  </div>

</MainLayout>

<style>
  .reg-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    background: var(--bg);
  }

  .reg-back {
    position: fixed;
    top: 24px;
    left: 32px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .reg-back:hover { color: var(--dark); }

  .reg-card {
    width: 100%;
    max-width: 420px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 20px;
    padding: 40px;
    box-shadow:
      0 1px 2px rgba(0,0,0,0.03),
      0 4px 16px rgba(0,0,0,0.06),
      0 16px 48px rgba(0,0,0,0.07);
  }

  .reg-head { margin-bottom: 32px; }

  .reg-eyebrow {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .reg-title {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 10px;
  }

  .reg-sub {
    font-size: 14px;
    color: var(--mid);
    line-height: 1.6;
  }

  .reg-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .reg-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .reg-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .reg-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .reg-forgot {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .reg-forgot:hover { color: var(--trop); }

  .reg-input {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--dark);
    background: var(--bg);
    border: 1.5px solid var(--rule);
    border-radius: 10px;
    padding: 12px 16px;
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }
  .reg-input::placeholder { color: var(--muted); }
  .reg-input:focus { border-color: var(--trop); }

  .reg-submit {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    background: var(--trop);
    border: none;
    border-radius: 10px;
    padding: 15px 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.18s;
    margin-top: 4px;
    box-shadow: 0 4px 20px var(--trop-glow);
    letter-spacing: 0.01em;
  }
  .reg-submit:hover {
    background: var(--trop-deep);
    transform: translateY(-1px);
    box-shadow: 0 8px 28px var(--trop-glow);
  }

  .reg-login {
    margin-top: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .reg-login a {
    color: var(--trop);
    text-decoration: none;
    font-weight: 600;
  }
  .reg-login a:hover { text-decoration: underline; }
</style>

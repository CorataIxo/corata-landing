import HeroSection from '../components/sections/HeroSection.astro';
import BridgeSection from '../components/sections/BridgeSection.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import ProfileSection from '../components/sections/ProfileSection.astro';
import TrainerSection from '../components/sections/TrainerSection.astro';

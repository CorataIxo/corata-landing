---
import PhysicsCanvas from '../components/PhysicsCanvas.astro';
import SkillBadge   from '../components/SkillBadge.astro';
import OverviewCard from '../components/OverviewCard.astro';
import ChallengePreview from '../components/ChallengePreview.astro';
import '../styles/global.css';
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Corata — Tu Talento Verificado</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --plum:        #3E1F47;
      --plum-deep:   #2A1231;
      --plum-dim:    rgba(62,31,71,0.10);
      --plum-glow:   rgba(62,31,71,0.22);
      --yellow:      #FFD000;
      --yellow-hl:   rgba(255,208,0,0.35);
      --dark:   #0D0D0B;
      --mid:    #555550;
      --muted:  #9A9A92;
      --bg:     #F7F5F1;
      --surface:#F2F0EC;
      --rule:   #EBEBEA;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--dark);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── FIXED HALO ── eggplant, bottom-right ── */
    .halo {
      position: fixed;
      bottom: -400px;
      right: -350px;
      width: 1100px;
      height: 1100px;
      background: radial-gradient(
        circle at 50% 50%,
        rgba(107,45,94,0.22) 0%,
        rgba(107,45,94,0.07) 50%,
        transparent 70%
      );
      filter: blur(110px);
      pointer-events: none;
      z-index: 0;
      border-radius: 50%;
      animation: haloPulse 14s ease-in-out infinite;
    }

    @keyframes haloPulse {
      0%,100% { transform: scale(1); }
      50%      { transform: scale(1.05) translate(-24px, -28px); }
    }

    /* ── CANVAS ── */
    #physics-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 200;
      background: rgba(255,255,255,0.90);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--rule);
      height: 60px;
      padding: 0 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-weight: 900;
      font-size: 15px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dark);
    }

    .nav-r { display: flex; align-items: center; gap: 8px; }

    .nav-btn-ghost {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: var(--mid);
      background: transparent;
      border: 1.5px solid var(--rule);
      padding: 7px 18px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.01em;
    }
    .nav-btn-ghost:hover { border-color: #ccc; color: var(--dark); }

    .nav-btn-solid {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 700;
      color: var(--dark);
      background: var(--yellow);
      border: none;
      padding: 8px 18px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.01em;
    }
    .nav-btn-solid:hover { filter: brightness(0.93); }

    /* ── HERO ── */
    .hero {
      position: relative;
      z-index: 10;
      max-width: 1200px;
      margin: 0 auto;
      padding: 72px 48px 96px;
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 64px;
      align-items: center;
      min-height: calc(100vh - 60px);
    }

    @media (max-width: 960px) {
      .hero { grid-template-columns: 1fr; min-height: auto; padding: 52px 28px 72px; gap: 52px; }
    }

    .eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .eyebrow::before {
      content: '';
      width: 20px;
      height: 1.5px;
      background: var(--yellow);
      flex-shrink: 0;
    }

    h1 {
      font-weight: 900;
      font-size: clamp(52px, 7vw, 88px);
      line-height: 0.96;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      color: var(--dark);
      margin-bottom: 28px;
    }

    h1 .dim { color: #D4D4D0; }

    /* Yellow rotulador highlight on key word */
    h1 .hl {
      position: relative;
      display: inline;
      white-space: nowrap;
    }
    h1 .hl::after {
      content: '';
      position: absolute;
      left: -2px;
      right: -2px;
      bottom: 6px;
      height: 10px;
      background: var(--yellow);
      opacity: 0.4;
      border-radius: 2px;
      z-index: -1;
      transform: scaleX(0);
      transform-origin: left;
      animation: hlGrow 0.6s 0.7s cubic-bezier(.16,1,.3,1) forwards;
    }
    @keyframes hlGrow { to { transform: scaleX(1); } }

    .hero-sub {
      font-size: 17px;
      font-weight: 400;
      line-height: 1.72;
      color: var(--mid);
      max-width: 440px;
      margin-bottom: 40px;
    }
    .hero-sub b { font-weight: 600; color: var(--dark); }

    .ctas { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

    .btn-primary {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      color: #fff;
      background: #3E1F47;
      border: none;
      padding: 18px 40px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.22s;
      font-size: 13px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      box-shadow: 0 4px 20px rgba(62,31,71,0.25);
    }
    .btn-primary:hover {
      background: #2A1231;
      transform: translateY(-2px);
      box-shadow: 0 10px 32px rgba(62,31,71,0.35);
    }

    .btn-secondary {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: var(--mid);
      background: transparent;
      border: 1.5px solid var(--rule);
      padding: 18px 26px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-secondary:hover { border-color: #ccc; color: var(--dark); }

    /* proof */
    .proof {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 48px;
      padding-top: 26px;
      border-top: 1px solid var(--rule);
    }
    .avs { display: flex; }
    .av {
      width: 30px; height: 30px;
      border-radius: 50%;
      border: 2.5px solid var(--bg);
      background: var(--rule);
      color: var(--mid);
      font-size: 10px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: -9px;
    }
    .av:first-child { margin-left: 0; }
    .av.y { background: var(--plum-dim); color: #2A1231; }
    .proof-copy { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
    .proof-copy b { font-weight: 600; color: var(--mid); }

    /* ── CARD ── */
    .card-zone {
      position: relative;
      display: flex;
      justify-content: center;
    }
    .card-zone::after {
      content: '';
      position: absolute;
      bottom: -20px;
      left: 50%;
      transform: translateX(-50%);
      width: 65%;
      height: 40px;
      background: radial-gradient(ellipse, var(--plum-glow) 0%, transparent 70%);
      filter: blur(10px);
      z-index: 0;
      pointer-events: none;
    }

    .profile-card {
      background: var(--bg);
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 20px;
      width: 100%;
      max-width: 360px;
      overflow: hidden;
      position: relative;
      z-index: 1;
      box-shadow:
        0 1px 2px rgba(0,0,0,0.04),
        0 4px 12px rgba(0,0,0,0.06),
        0 16px 40px rgba(0,0,0,0.08),
        0 40px 80px rgba(0,0,0,0.07);
      animation: floatCard 7s ease-in-out infinite;
    }

    /* Top accent — thin, single green line. Arquitectónico, no decorativo. */
    .profile-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: #3E1F47;
      z-index: 2;
      border-radius: 20px 20px 0 0;
    }

    @keyframes floatCard {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-10px); }
    }

    .card-head {
      padding: 18px 22px;
      border-bottom: 1px solid var(--rule);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .card-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .v-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--plum-dim);
      border: 1px solid rgba(255,208,0,0.35);
      border-radius: 100px;
      padding: 3px 10px 3px 8px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #2A1231;
    }
    .v-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--yellow);
      flex-shrink: 0;
      animation: blink 2s ease infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.35} }

    .score-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--rule);
    }
    .score-cell {
      padding: 18px 22px;
    }
    .score-cell:first-child { border-right: 1px solid var(--rule); }
    .sc-val {
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--dark);
      margin-bottom: 3px;
    }
    .sc-val.accent { color: #3E1F47; }
    .sc-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* Skill row hover glow */
    .skill-row {
      transition: background 0.15s;
      cursor: default;
    }
    .skill-row:hover {
      background: linear-gradient(90deg, rgba(62,31,71,0.04) 0%, transparent 100%);
    }

    /* ── SCENARIO PREVIEW ── */
    .scenario-box {
      margin-top: 32px;
      border: 1px solid var(--rule);
      border-left: 2px solid var(--yellow);
      border-radius: 10px;
      padding: 16px 20px;
      background: rgba(255,208,0,0.03);
      max-width: 440px;
    }
    .scenario-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--yellow);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .scenario-tag::before {
      content: '';
      width: 4px; height: 4px;
      border-radius: 50%;
      background: var(--yellow);
      flex-shrink: 0;
    }
    .scenario-text {
      font-size: 13px;
      font-weight: 400;
      line-height: 1.65;
      color: var(--mid);
      font-style: italic;
    }
    .scenario-text em {
      font-style: normal;
      font-weight: 600;
      color: var(--dark);
    }

    /* ── PIPELINE ── */
    .pipeline {
      display: flex;
      align-items: center;
      gap: 0;
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--rule);
      flex-wrap: wrap;
      gap: 2px;
    }
    .pipe-step {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--muted);
      white-space: nowrap;
    }
    .pipe-step.active {
      color: var(--plum);
      font-weight: 600;
    }
    .pipe-arrow {
      font-size: 11px;
      color: var(--rule);
      margin: 0 8px;
      flex-shrink: 0;
    }

    .card-foot {
      padding: 12px 22px;
      background: linear-gradient(90deg, rgba(62,31,71,0.05) 0%, var(--surface) 100%);
      border-top: 1px solid rgba(62,31,71,0.12);
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .foot-icon { font-size: 11px; color: #3E1F47; opacity: 0.5; flex-shrink: 0; margin-top: 1px; }
    .foot-text { font-size: 11px; color: var(--muted); line-height: 1.55; }
    .foot-text b { font-weight: 600; color: var(--mid); }

    /* ── SECTION RULE ── */
    .s-rule { border: none; border-top: 1px solid var(--rule); max-width: 1200px; margin: 0 auto; }

    /* ── PROCESS ── */
    .process {
      position: relative;
      z-index: 10;
      max-width: 1200px;
      margin: 0 auto;
      padding: 80px 48px 96px;
    }
    @media (max-width: 960px) { .process { padding: 56px 28px 72px; } }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 48px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .s-eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .s-title {
      font-size: clamp(26px, 3.2vw, 38px);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--dark);
      text-align: right;
      max-width: 460px;
      line-height: 1.12;
      text-transform: uppercase;
    }
    @media (max-width: 700px) { .s-title { text-align: left; } }

    .steps {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
      border-radius: 16px;
      overflow: hidden;
    }
    @media (max-width: 700px) { .steps { grid-template-columns: 1fr; } }

    .step {
      background: var(--bg);
      padding: 38px 32px;
      cursor: default;
      transition: background 0.16s;
    }
    .step:hover { background: var(--surface); }

    .step-n {
      font-size: 48px;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--rule);
      line-height: 1;
      margin-bottom: 24px;
      transition: color 0.18s;
    }
    .step:hover .step-n { color: var(--plum); }

    .step-t {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      color: var(--dark);
      margin-bottom: 10px;
      line-height: 1.3;
    }
    .step-b { font-size: 14px; color: var(--mid); line-height: 1.7; }
    .step-b b { font-weight: 600; color: var(--dark); }

    /* ── CTA BAND ── */
    .cta-band {
      position: relative;
      z-index: 10;
      background: var(--dark);
      overflow: hidden;
    }
    .cta-band::before {
      content: '';
      position: absolute;
      top: -120px; right: -80px;
      width: 480px; height: 480px;
      background: radial-gradient(circle, rgba(255,208,0,0.10) 0%, transparent 65%);
      pointer-events: none;
    }

    .cta-inner {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 88px 48px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: end;
    }
    @media (max-width: 700px) { .cta-inner { grid-template-columns: 1fr; gap: 48px; padding: 56px 28px; } }

    .cta-h {
      font-size: clamp(40px, 5.5vw, 68px);
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 0.96;
      text-transform: uppercase;
      color: #F5F5F3;
      margin-bottom: 18px;
    }
    .cta-h em { font-style: normal; color: var(--plum); }
    .cta-p { font-size: 16px; color: rgba(245,245,243,0.38); line-height: 1.7; }

    .cta-right { display: flex; flex-direction: column; }

    .trust-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .t-label { font-size: 13px; color: rgba(245,245,243,0.40); }
    .t-check {
      width: 19px; height: 19px;
      border-radius: 50%;
      background: #3E1F47;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .t-check svg { width: 10px; height: 10px; }

    .btn-cta {
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      background: #3E1F47;
      border: none;
      padding: 17px 28px;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.18s;
      box-shadow: 0 4px 24px rgba(255,208,0,0.25);
      letter-spacing: 0.01em;
    }
    .btn-cta:hover { filter: brightness(0.96); transform: translateY(-1px); }
    .btn-cta .arr { font-size: 18px; transition: transform 0.18s; }
    .btn-cta:hover .arr { transform: translate(2px,-2px); }

    /* ── FADE UP ── */
    @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
    .fu      { opacity:0; transform:translateY(18px); animation: fadeUp .65s ease forwards; }
    .d1 { animation-delay:.05s }
    .d2 { animation-delay:.16s }
    .d3 { animation-delay:.27s }
    .d4 { animation-delay:.38s }
    .d5 { animation-delay:.49s }
    .card-in { opacity:0; transform:translateY(22px); animation: fadeUp .8s .22s ease forwards; }
  </style>
</head>

<body>

  <!-- Fixed aurora halo — stays in corner while scrolling -->
  <div class="halo"></div>

  <PhysicsCanvas />

  <!-- NAV -->
  <nav>
    <div class="logo">Corata</div>
    <div class="nav-r">
      <button class="nav-btn-ghost">Para empresas</button>
      <button class="nav-btn-solid">Acceder</button>
    </div>
  </nav>

  <!-- HERO -->
  <main class="hero">

    <!-- Left -->
    <div>
      <div class="eyebrow fu d1">Sistema de evaluación conductual</div>

      <h1 class="fu d2">
        Demuestra<br/>
        <span class="hl">cómo piensas</span><br/>
        <span class="dim">No lo que<br/>declaras</span>
      </h1>

      <p class="hero-sub fu d3">
        Completa retos basados en situaciones reales de trabajo.
        Corata analiza tus respuestas y genera un <b>perfil de ejecución verificado</b> — sin CV, sin sesgos.
      </p>

      <!-- Scenario preview -->
      <div class="scenario-box fu d3">
        <div class="scenario-tag">Ejemplo de reto</div>
        <p class="scenario-text">
          Gestionas varias tareas. A mitad del tiempo, <em>las prioridades cambian por un evento externo.</em>
          Reorganiza tu flujo. El sistema mide tu velocidad de adaptación y tu razonamiento estructural.
        </p>
      </div>

      <div class="ctas fu d4" style="margin-top:28px">
        <button class="btn-primary">Iniciar primer reto</button>
        <button class="btn-secondary">Ver cómo funciona</button>
      </div>

      <!-- Pipeline -->
      <div class="pipeline fu d5">
        <span class="pipe-step">Reto real</span>
        <span class="pipe-arrow">→</span>
        <span class="pipe-step">Observación conductual</span>
        <span class="pipe-arrow">→</span>
        <span class="pipe-step">Medición</span>
        <span class="pipe-arrow">→</span>
        <span class="pipe-step active">Perfil verificado</span>
      </div>
    </div>

    <!-- Right — challenge → profile (system flow) -->
    <div class="card-zone" style="display:flex;flex-direction:column;gap:0;align-items:flex-end;">

      <!-- Card 1: Challenge Preview — INPUT -->
      <div class="card-in" style="width:100%;max-width:360px;animation-delay:0.1s">
        <ChallengePreview />
      </div>

      <!-- Connector: reto → perfil -->
      <div style="display:flex;align-items:center;justify-content:flex-end;width:100%;max-width:360px;padding:10px 28px;gap:8px;">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:8.5px;letter-spacing:0.10em;text-transform:uppercase;color:#CECECE">genera</span>
        <div style="flex:1;height:1px;background:linear-gradient(90deg,rgba(107,45,94,0.15),rgba(107,45,94,0.40))"></div>
        <span style="color:#CECECE;font-size:11px;transform:rotate(90deg);display:inline-block">↓</span>
      </div>

      <!-- Card 2: Execution Profile — OUTPUT -->
      <div class="profile-card card-in" style="animation-delay:0.24s">

        <div class="card-head">
          <div>
            <span class="card-label">Perfil de ejecución</span>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--muted);letter-spacing:0.08em;margin-top:2px;opacity:0.6">Generado por comportamiento observado</div>
          </div>
          <div class="v-pill">
            <span class="v-dot"></span>
            Verificado
          </div>
        </div>

        <div class="score-row">
          <div class="score-cell">

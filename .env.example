# Copia este archivo como .env y rellena con tus valores de Supabase
# Dashboard → Project Settings → API

# URL del proyecto (se puede exponer al cliente)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (se puede exponer al cliente — respeta RLS)
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# NUNCA expongas la service_role key al cliente ni la subas a git
# Solo para scripts de admin o migraciones server-side
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
